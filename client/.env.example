# Game server WebSocket URL (defaults to ws://localhost:8080)
VITE_WS_URL=ws://localhost:8080

# Blockchain RPC URLs (format: chainId:rpcUrl,chainId:rpcUrl)
# Example for Polygon mainnet with a dedicated RPC:
# VITE_BLOCKCHAIN_RPCS=137:https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
VITE_BLOCKCHAIN_RPCS=

# WalletConnect project ID (optional, has built-in fallback)
VITE_WALLETCONNECT_PROJECT_ID=
